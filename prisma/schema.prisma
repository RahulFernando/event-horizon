generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                    @id @default(uuid())
  name                      String
  contacts                  String[]
  user_type                 UserType                  @default(ORGANIZER)
  created_at                DateTime                  @default(now())
  created_by                String
  updated_at                DateTime                  @updatedAt
  updated_by                String
  account                   Account?
  addresses                 Address[]
  organizers                Organizer?
  vendors                   Vendor?
  conversation_participants ConversationParticipant[]
  sent_messages             Message[]

  @@map("users")
}

model Address {
  id          String   @id @default(uuid())
  number      String?
  line_1      String
  line_2      String?
  state       String?
  country     String
  postal_code String
  user_id     String
  created_at  DateTime @default(now())
  created_by  String
  updated_at  DateTime @updatedAt
  updated_by  String
  user        User     @relation(fields: [user_id], references: [id])

  @@map("addresses")
}

model Country {
  id         String   @id @default(uuid())
  name       String
  currency   String
  created_at DateTime @default(now())
  created_by String
  updated_at DateTime @updatedAt
  updated_by String

  @@map("countries")
}

model Account {
  id                  String   @id @default(uuid())
  email               String   @unique
  password            String
  profile_picture_url String?
  user_id             String   @unique
  created_at          DateTime @default(now())
  created_by          String
  updated_at          DateTime @updatedAt
  updated_by          String
  user                User     @relation(fields: [user_id], references: [id])

  @@index([email])
  @@map("accounts")
}

model Organizer {
  id                String    @id @default(uuid())
  first_name        String
  last_name         String?
  national_identity String?   @unique
  user_id           String    @unique
  created_at        DateTime  @default(now())
  created_by        String
  updated_at        DateTime  @updatedAt
  updated_by        String
  is_deleted        Boolean   @default(false)
  deleted_at        DateTime?
  deleted_by        String?
  Event             Event[]
  user              User      @relation(fields: [user_id], references: [id])

  @@index([national_identity])
  @@map("organizers")
}

model Vendor {
  id                             String     @id @default(uuid())
  business_registration          String?    @unique
  taxpayer_identification_number String?    @unique
  user_id                        String     @unique
  container                      String?
  created_at                     DateTime   @default(now())
  created_by                     String
  updated_at                     DateTime   @updatedAt
  updated_by                     String
  is_deleted                     Boolean    @default(false)
  deleted_at                     DateTime?
  deleted_by                     String?
  user                           User       @relation(fields: [user_id], references: [id])
  gigs                           Gig[]
  calendar                       Calendar[]

  @@index([business_registration, taxpayer_identification_number])
  @@map("vendors")
}

model Event {
  id            String    @id @default(uuid())
  title         String
  duration      String?
  date_time     DateTime
  event_type_id String
  venue         String?
  organizer_id  String
  created_at    DateTime  @default(now())
  created_by    String
  updated_at    DateTime  @updatedAt
  updated_by    String
  event_type    EventType @relation(fields: [event_type_id], references: [id])
  organizer     Organizer @relation(fields: [organizer_id], references: [id])
  job           Job[]

  @@map("events")
}

model EventType {
  id         String             @id @default(uuid())
  name       String             @unique
  created_at DateTime           @default(now())
  created_by String
  updated_at DateTime           @updatedAt
  updated_by String
  event      Event[]
  gigs       EventTypesOnGigs[]

  @@map("event_types")
}

enum UserType {
  ORGANIZER
  VENDOR
  ADMIN
  CUSTOMER_SUPPORT_REPRESENTATIVE
}

model Gig {
  id           String             @id @default(uuid())
  title        String
  description  String?
  location     String
  blob_url     String?
  event_types  EventTypesOnGigs[]
  vendor       Vendor             @relation(fields: [vendor_id], references: [id])
  pricing_mode PricingModel?
  vendor_id    String
  created_at   DateTime           @default(now())
  created_by   String
  updated_at   DateTime           @updatedAt
  updated_by   String
  category     Category?          @relation(fields: [category_id], references: [id])
  category_id  String
  jobs         Job[]

  @@map("gigs")
}

model Category {
  id         String   @id @default(uuid())
  name       String   @unique
  img_url    String?
  created_at DateTime @default(now())
  created_by String
  updated_at DateTime @updatedAt
  updated_by String
  gigs       Gig[]

  @@map("categories")
}

model EventTypesOnGigs {
  gig           Gig       @relation(fields: [gig_id], references: [id], onDelete: Cascade)
  event_type    EventType @relation(fields: [event_type_id], references: [id], onDelete: Cascade)
  gig_id        String
  event_type_id String

  @@id([gig_id, event_type_id])
  @@map("event_types_on_gigs")
}

model PricingModel {
  id          String           @id @default(uuid())
  type        PricingModelType @default(FIXED)
  fixed_rate  FixedRate?
  hourly_rate HourlyRate?
  tiered      Tiered?
  gig         Gig              @relation(fields: [gig_id], references: [id], onDelete: Cascade)
  gig_id      String           @unique
  created_at  DateTime         @default(now())
  created_by  String
  updated_at  DateTime         @updatedAt
  updated_by  String

  @@map("pricing_models")
}

enum PricingModelType {
  FIXED
  HOURLY_RATE
  TIERED
}

model FixedRate {
  id               String       @id @default(uuid())
  price            Float
  pricing_model    PricingModel @relation(fields: [pricing_model_id], references: [id], onDelete: Cascade)
  pricing_model_id String       @unique

  @@map("fixed_rates")
}

model HourlyRate {
  id               String       @id @default(uuid())
  hour             String
  price            Float
  pricing_model    PricingModel @relation(fields: [pricing_model_id], references: [id], onDelete: Cascade)
  pricing_model_id String       @unique

  @@map("hourly_rates")
}

model Tiered {
  id               String        @id @default(uuid())
  pricing_model    PricingModel  @relation(fields: [pricing_model_id], references: [id], onDelete: Cascade)
  pricing_model_id String        @unique
  pricing_tiers    PricingTier[]

  @@map("tiereds")
}

model PricingTier {
  id          String @default(uuid())
  level       String
  description String
  price       Float
  tiered      Tiered @relation(fields: [tiered_id], references: [id], onDelete: Cascade)
  tiered_id   String
  jobs        Job[]

  @@id([id, tiered_id])
  @@map("pricing_tiers")
}

model Job {
  id                     String       @default(uuid())
  gig                    Gig          @relation(fields: [gig_id], references: [id])
  event                  Event        @relation(fields: [event_id], references: [id])
  gig_id                 String       @unique
  event_id               String       @unique
  pricingTier            PricingTier? @relation(fields: [pricing_tier_id, pricing_tier_tiered_id], references: [id, tiered_id])
  pricing_tier_tiered_id String?
  pricing_tier_id        String?
  status                 JobStatus    @default(PENDING)
  created_at             DateTime     @default(now())
  created_by             String
  updated_at             DateTime     @updatedAt
  updated_by             String
  calendar               Calendar[]

  @@id([id])
  @@map("jobs")
}

enum JobStatus {
  PENDING
  ACCEPTED
  REJECTED
  ACTIVE
  COMPLETED
}

model Calendar {
  id         String   @id @default(uuid())
  vendor_id  String
  job_id     String
  date_time  DateTime
  created_at DateTime @default(now())
  created_by String
  updated_at DateTime @updatedAt
  updated_by String

  vendor Vendor @relation(fields: [vendor_id], references: [id])
  job    Job    @relation(fields: [job_id], references: [id])

  @@map("calendars")
}

model Conversation {
  id           String                    @id @default(uuid())
  title        String?
  created_at   DateTime                  @default(now())
  created_by   String
  updated_at   DateTime                  @updatedAt
  updated_by   String
  is_deleted   Boolean                   @default(false)
  deleted_at   DateTime?
  deleted_by   String?
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id              String    @id @default(uuid())
  user_id         String
  conversation_id String
  joined_at       DateTime  @default(now())
  left_at         DateTime?
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  created_by      String
  updated_at      DateTime  @updatedAt
  updated_by      String

  user          User          @relation(fields: [user_id], references: [id])
  conversation  Conversation  @relation(fields: [conversation_id], references: [id])
  read_receipts ReadReceipt[]

  @@unique([user_id, conversation_id])
  @@index([user_id])
  @@index([conversation_id])
  @@map("conversation_participants")
}

model Message {
  id              String    @id @default(uuid())
  conversation_id String
  sender_id       String
  content         String
  sent_at         DateTime  @default(now())
  is_deleted      Boolean   @default(false)
  deleted_at      DateTime?
  deleted_by      String?
  created_at      DateTime  @default(now())
  created_by      String
  updated_at      DateTime  @updatedAt
  updated_by      String

  conversation  Conversation  @relation(fields: [conversation_id], references: [id])
  sender        User          @relation(fields: [sender_id], references: [id])
  read_receipts ReadReceipt[]

  @@index([conversation_id])
  @@index([sender_id])
  @@map("messages")
}

model ReadReceipt {
  id             String   @id @default(uuid())
  message_id     String
  participant_id String
  read_at        DateTime @default(now())
  created_at     DateTime @default(now())

  message     Message                 @relation(fields: [message_id], references: [id])
  participant ConversationParticipant @relation(fields: [participant_id], references: [id])

  @@unique([message_id, participant_id])
  @@index([message_id])
  @@index([participant_id])
  @@map("read_receipts")
}
