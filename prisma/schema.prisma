generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(uuid())
  name       String
  contacts   String[]
  user_type  UserType   @default(ORGANIZER)
  created_at DateTime   @default(now())
  created_by String
  updated_at DateTime   @updatedAt
  updated_by String
  account    Account?
  addresses  Address[]
  organizers Organizer?
  vendors    Vendor?

  @@map("users")
}

model Address {
  id          String   @id @default(uuid())
  number      String?
  line_1      String
  line_2      String?
  state       String?
  country     String
  postal_code String
  user_id     String
  created_at  DateTime @default(now())
  created_by  String
  updated_at  DateTime @updatedAt
  updated_by  String
  user        User     @relation(fields: [user_id], references: [id])

  @@map("addresses")
}

model Country {
  id         String   @id @default(uuid())
  name       String
  currency   String
  created_at DateTime @default(now())
  created_by String
  updated_at DateTime @updatedAt
  updated_by String

  @@map("countries")
}

model Account {
  id                  String   @id @default(uuid())
  email               String   @unique
  password            String
  profile_picture_url String?
  user_id             String   @unique
  created_at          DateTime @default(now())
  created_by          String
  updated_at          DateTime @updatedAt
  updated_by          String
  user                User     @relation(fields: [user_id], references: [id])

  @@index([email])
  @@map("accounts")
}

model Organizer {
  id                String   @id @default(uuid())
  first_name        String
  last_name         String?
  national_identity String?  @unique
  user_id           String   @unique
  created_at        DateTime @default(now())
  created_by        String
  updated_at        DateTime @updatedAt
  updated_by        String
  Event             Event[]
  user              User     @relation(fields: [user_id], references: [id])

  @@index([national_identity])
  @@map("organizers")
}

model Vendor {
  id                             String   @id @default(uuid())
  business_registration          String?  @unique
  taxpayer_identification_number String?  @unique
  user_id                        String   @unique
  container                      String?
  created_at                     DateTime @default(now())
  created_by                     String
  updated_at                     DateTime @updatedAt
  updated_by                     String
  user                           User     @relation(fields: [user_id], references: [id])
  gigs                           Gig[]

  @@index([business_registration, taxpayer_identification_number])
  @@map("vendors")
}

model Event {
  id            String    @id @default(uuid())
  title         String
  duration      String?
  date_time     DateTime
  event_type_id String
  venue         String?
  organizer_id  String
  created_at    DateTime  @default(now())
  created_by    String
  updated_at    DateTime  @updatedAt
  updated_by    String
  event_type    EventType @relation(fields: [event_type_id], references: [id])
  orgernizer    Organizer @relation(fields: [organizer_id], references: [id])

  @@map("events")
}

model EventType {
  id         String   @id @default(uuid())
  name       String   @unique
  created_at DateTime @default(now())
  created_by String
  updated_at DateTime @updatedAt
  updated_by String
  event      Event[]
  gig        Gig[]

  @@map("event_types")
}

enum UserType {
  ORGANIZER
  VENDOR
  ADMIN
  CUSTOMER_SUPPORT_REPRESENTATIVE
}

model Gig {
  id            String    @id @default(uuid())
  title         String
  description   String?
  location      String
  blob_url      String?
  event_type    EventType @relation(fields: [event_type_id], references: [id])
  event_type_id String
  vendor        Vendor    @relation(fields: [vendor_id], references: [id])
  vendor_id     String
  created_at    DateTime  @default(now())
  created_by    String
  updated_at    DateTime  @updatedAt
  updated_by    String

  @@map("gigs")
}
